[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scenes/ui/main_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/ui/staff_ui_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/final/ui/hotel_interface/hotel_cover_background.png" id="3_cover"]
[ext_resource type="Texture2D" path="res://assets/final/ui/hotel_interface/title_bilingual.png" id="4_title"]

[ext_resource type="Script" path="res://scenes/ui/language_selector.gd" id="5_language"]
[ext_resource type="Script" path="res://scenes/ui/localized_title.gd" id="6_localized_title"]

[node name="MainMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Cover" type="TextureRect" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("3_cover")
expand_mode = 1
stretch_mode = 6

[node name="Title" type="TextureRect" parent="."]
layout_mode = 1
anchor_left = 0.17
anchor_top = 0.08
anchor_right = 0.61
anchor_bottom = 0.36
mouse_filter = 2
texture = ExtResource("4_title")
expand_mode = 1
stretch_mode = 5
script = ExtResource("6_localized_title")

[node name="Actions" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.205
anchor_top = 0.73
anchor_right = 0.39
grow_vertical = 0
theme_override_constants/separation = 10
mouse_filter = 2

[node name="StartButton" type="Button" parent="Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
focus_neighbor_bottom = NodePath("../HelpButton")
focus_neighbor_top = NodePath("../LanguageSelector")
text = "开始游戏"

[node name="HelpButton" type="Button" parent="Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
focus_neighbor_top = NodePath("../StartButton")
focus_neighbor_bottom = NodePath("../LanguageSelector")
text = "操作说明"

[node name="LanguageSelector" type="OptionButton" parent="Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
focus_neighbor_top = NodePath("../HelpButton")
focus_neighbor_bottom = NodePath("../StartButton")
script = ExtResource("5_language")

[connection signal="pressed" from="Actions/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Actions/HelpButton" to="." method="_on_help_pressed"]
