[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/main_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/ui/staff_ui_theme.tres" id="2_theme"]

[node name="MainMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.038, 0.065, 0.075, 0.95)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Eyebrow" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "夜班旅馆  /  员工入口"
horizontal_alignment = 1

[node name="Title" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 49
text = "怪物员工通道"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.69, 0.77, 0.76, 1)
theme_override_font_sizes/font_size = 18
text = "MONSTER STAFF ACCESS"
horizontal_alignment = 1

[node name="Divider" type="HSeparator" parent="Center/Panel/Content"]
layout_mode = 2

[node name="StartButton" type="Button" parent="Center/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
focus_neighbor_bottom = NodePath("../HelpButton")
text = "开始游戏"

[node name="HelpButton" type="Button" parent="Center/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
focus_neighbor_top = NodePath("../StartButton")
text = "操作说明"

[connection signal="pressed" from="Center/Panel/Content/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Center/Panel/Content/HelpButton" to="." method="_on_help_pressed"]
