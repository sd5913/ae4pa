[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/help.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/ui/staff_ui_theme.tres" id="2_theme"]

[node name="Help" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.045, 0.054, 0.93)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(720, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Eyebrow" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 18
text = "夜班旅馆  /  员工手册"

[node name="Title" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "操作说明"

[node name="Keys" type="GridContainer" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 5
columns = 2

[node name="LeftKey" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "A / ←"

[node name="LeftDescription" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "向左移动，松开停止。"

[node name="RightKey" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "D / →"

[node name="RightDescription" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "向右移动，松开停止。"

[node name="InteractKey" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "E"

[node name="InteractDescription" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "按住偷取工作证，轻按可救援或使用楼梯、出口。"

[node name="SwitchKey" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "Q"

[node name="SwitchDescription" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "在两个佩戴槽之间切换当前工作证。"

[node name="BagKey" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "I"

[node name="BagDescription" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "打开背包，调整两个佩戴槽。"

[node name="HelpKey" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "H"

[node name="HelpDescription" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "打开或关闭这份操作说明。"

[node name="PauseKey" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
text = "Esc"

[node name="PauseDescription" type="Label" parent="Center/Panel/Content/Keys"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "打开暂停菜单。"

[node name="CardNote" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.69, 0.77, 0.76, 1)
theme_override_font_sizes/font_size = 18
text = "工作证有保安、保洁、经理三种。最多佩戴两张，每次只有一张生效。"
autowrap_mode = 2

[node name="CloseButton" type="Button" parent="Center/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
focus_neighbor_left = NodePath(".")
focus_neighbor_top = NodePath(".")
focus_neighbor_right = NodePath(".")
focus_neighbor_bottom = NodePath(".")
focus_next = NodePath(".")
focus_previous = NodePath(".")
text = "关闭说明"

[connection signal="pressed" from="Center/Panel/Content/CloseButton" to="." method="close_help"]
