[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/bag.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/ui/staff_ui_theme.tres" id="2_theme"]

[node name="Bag" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.045, 0.054, 0.93)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Eyebrow" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
text = "夜班旅馆  /  员工随身物品"

[node name="Title" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "工作证背包"

[node name="Divider" type="HSeparator" parent="Center/Panel/Content"]
layout_mode = 2

[node name="CardsAndSlots" type="HBoxContainer" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Owned" type="VBoxContainer" parent="Center/Panel/Content/CardsAndSlots"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Center/Panel/Content/CardsAndSlots/Owned"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
text = "已获得的工作证"

[node name="OwnedCards" type="ItemList" parent="Center/Panel/Content/CardsAndSlots/Owned"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(260, 150)
theme_override_font_sizes/font_size = 20
select_mode = 0
allow_reselect = true

[node name="Divider" type="VSeparator" parent="Center/Panel/Content/CardsAndSlots"]
layout_mode = 2

[node name="Slots" type="GridContainer" parent="Center/Panel/Content/CardsAndSlots"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 8
columns = 2

[node name="SlotALabel" type="Label" parent="Center/Panel/Content/CardsAndSlots/Slots"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
theme_override_colors/font_color = Color(0.69, 0.77, 0.76, 1)
text = "槽 A"

[node name="SlotAValue" type="Label" parent="Center/Panel/Content/CardsAndSlots/Slots"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22

[node name="SlotBLabel" type="Label" parent="Center/Panel/Content/CardsAndSlots/Slots"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
theme_override_colors/font_color = Color(0.69, 0.77, 0.76, 1)
text = "槽 B"

[node name="SlotBValue" type="Label" parent="Center/Panel/Content/CardsAndSlots/Slots"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22

[node name="EquipActions" type="HBoxContainer" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="EquipSlotA" type="Button" parent="Center/Panel/Content/EquipActions"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
size_flags_horizontal = 3
text = "装备到槽 A"

[node name="EquipSlotB" type="Button" parent="Center/Panel/Content/EquipActions"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
size_flags_horizontal = 3
text = "装备到槽 B"

[node name="Status" type="Label" parent="Center/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
text = ""

[node name="CloseButton" type="Button" parent="Center/Panel/Content"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
theme_type_variation = &"PrimaryButton"
focus_neighbor_left = NodePath(".")
focus_neighbor_top = NodePath(".")
focus_neighbor_right = NodePath(".")
focus_neighbor_bottom = NodePath(".")
focus_next = NodePath(".")
focus_previous = NodePath(".")
text = "关闭背包（I）"

[connection signal="pressed" from="Center/Panel/Content/CloseButton" to="." method="close_bag"]
