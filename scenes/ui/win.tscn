[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/win.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/ui/staff_ui_theme.tres" id="2_theme"]

[node name="Win" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.045, 0.054, 0.93)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Eyebrow" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.97, 0.72, 0.39, 1)
theme_override_font_sizes/font_size = 19
horizontal_alignment = 1
text = "夜班旅馆  /  逃脱成功"

[node name="Title" type="Label" parent="Center/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 52
horizontal_alignment = 1
text = "ESCAPED"

[node name="Ending" type="Label" parent="Center/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1
text = "你和同伴成功逃出了旅馆。"

[node name="StatisticsNote" type="Label" parent="Center/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.69, 0.77, 0.76, 1)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
text = "通关统计待 A 接入"

[node name="Actions" type="HBoxContainer" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="RestartButton" type="Button" parent="Center/Panel/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PrimaryButton"
text = "重新开始"

[node name="ReturnButton" type="Button" parent="Center/Panel/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "返回菜单"

[connection signal="pressed" from="Center/Panel/Content/Actions/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Center/Panel/Content/Actions/ReturnButton" to="." method="_on_return_to_menu_pressed"]
